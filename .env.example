# Prospector Environment Configuration

# ============================================================
# Required API Keys
# ============================================================

# OpenAI API key for LLM calls
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Tavily API key for web search
TAVILY_API_KEY=tvly-dev-your-tavily-api-key-here

# ============================================================
# Optional API Keys
# ============================================================

# Anthropic API key (optional, used for some evaluations)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google API key (for Maps and related services)
GOOGLE_API_KEY=your-google-api-key-here

# Apify API key (for web scraping)
APIFY_API_KEY=your-apify-api-key-here

# Google Maps API key
MAPS_API_KEY=your-maps-api-key-here

# SerpAPI key (for search results)
SERPAPI_KEY=your-serpapi-key-here

# Google Cloud credentials path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/aiyana
# Neon (prod): postgresql://user:password@project.neon.tech/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiyana

# ============================================================
# Logging & Debugging
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# ============================================================
# LangSmith (Optional - for tracing & debugging)
# ============================================================

# LangSmith API key for tracing LLM calls
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key-here

# Enable LangSmith tracing
LANGSMITH_TRACING=true

# LangSmith project traces are grouped under (created on first trace if missing)
LANGSMITH_PROJECT=your-project-name

# Optional: Use EU instance endpoint
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
